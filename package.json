{
  "name": "rasterwright",
  "version": "0.1.0",
  "description": "Image policy and verification tool for software projects",
  "type": "module",
  "license": "MIT",
  "author": "Ron Holt",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rasterwright": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "rasterwright": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "picomatch": "^4.0.2",
    "sharp": "0.35.4",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
